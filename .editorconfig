# SPDX-License-Identifier: MPL-2.0
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{jl,R,r,py}]
indent_size = 4

[*.{md,adoc}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
