(repo-deed
  :schema-version "1.0.0"
  :canonical-name "MetaManifold-WebUI"
  :repo-uuid #u8"gv-clade-index:github.com/hyperpolymath/MetaManifold-WebUI"
  :beholding-chora #u5"estate/chora"
  (identity :owner "hyperpolymath" :primary-forge github :fork-of "JoshuaJewell/MetaManifold-WebUI")
  (front-doors :human "README.md" :agent "CONTRIBUTING.md")
  (authority
    :licensing "LICENSE"
    :contribution "CONTRIBUTING.md"
    :upstream "https://github.com/JoshuaJewell/MetaManifold-WebUI")
  (routing
    :upstream-candidates "upstream/*"
    :frontend "frontend/"
    :analysis "src/analysis/"
    :cladistics "docs/cladistics/"
    :statistics "docs/statistics/"
    :schemas "docs/schemas/"
    :proofs "proofs/"
    :contractiles ".machine_readable/contractiles/"
    :enforcement ".github/workflows/")
  (status
    :evidence-source ".github/workflows/hypatia-scan.yml"
    :evidence-status "Fork governance lane: DEED syntax, K9 L0-L2 contract conformance (must, trust, intend at Yard tier; L3 signatures not verified in CI), and the Hypatia verdict grid with gitbot-fleet report-backs. Upstream owns the application code and its CI; this deed describes the fork.")
  (policies
    (licensing
      :initial-assignment "New files the fork authors carry MPL-2.0 with an SPDX header, as upstream CONTRIBUTING.md permits."
      :existing-declarations "Manual-Only. LICENSE, CITATION.cff and every header upstream declares are never changed away from upstream's own declaration on this fork. A fork copy that has drifted from it is restored to it: proofs/ carries MPL-2.0 for code and CC-BY-SA-4.0 for prose, as upstream 4dce274 declares.")
    (fleet
      :enrolment ".gitbot-fleet/enrolment.json"
      :report-backs ".gitbot-fleet/report-backs/")))
